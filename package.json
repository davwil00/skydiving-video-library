{
  "name": "skydiving-video-library-v2",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm run validate && react-router build",
    "dev": "react-router dev --host",
    "lint": "react-router typegen && npx @biomejs/biome check .",
    "lint:fix": "npx @biomejs/biome check . --write",
    "format:fix": "npx @biomejs/biome format . --write",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "migrate-dev": "prisma generate && prisma migrate dev",
    "migrate-deploy": "prisma generate && prisma migrate deploy",
    "typecheck": "react-router typegen && tsc",
    "typegen": "react-router typegen",
    "test": "vitest --run",
    "start": "react-router-serve ./build/server/index.js",
    "generate": "prisma generate",
    "icons": "rimraf app/components/formations/8-way && npx @svgr/cli --out-dir app/components/formations/8-way -- public/images/8-way",
    "icons:watch": "npm-watch icons",
    "dev:svg": "run-s icons icons:watch",
    "validate": "tsc && npm run test"
  },
  "watch": {
    "icons": {
      "patterns": [
        "icons"
      ]
    },
    "extensions": "svg",
    "quiet": false
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/express": "^8.3.1",
    "@react-router/fs-routes": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1",
    "ffmetadata": "^1.7.0",
    "isbot": "^5.2.2",
    "lodash-es": "^4.18.1",
    "morgan": "^1.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@react-router/dev": "^8.3.1",
    "@svgr/cli": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "daisyui": "^5.7.28",
    "globals": "^17.12.0",
    "npm-run-all": "^4.1.5",
    "npm-watch": "^0.13.0",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
